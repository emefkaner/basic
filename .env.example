# ---- Zugang ----
# Passwort für den Login (nur du sollst rein). Bitte ändern!
APP_PASSWORD=bitte-aendern
# Zufälliger, langer Wert zum Signieren der Login-Cookies. Bitte ändern!
SESSION_SECRET=bitte-einen-langen-zufallswert-eintragen

# ---- Öffentliche Adresse der App ----
# Vollständige URL, unter der die App erreichbar ist (ohne Slash am Ende).
# WICHTIG für den RSS-Feed: Spotify braucht absolute Links zu den MP3s.
# Beispiel: https://mein-podcast.onrender.com
PUBLIC_URL=http://localhost:3000

# ---- Transkription (Pflicht für KI-Text aus Audio) ----
# OpenAI-Key für Whisper-Transkription. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Infotext-Generierung ----
# Anthropic-Key für die KI-Zusammenfassung (Claude). https://console.anthropic.com
# Optional: fehlt der Key, wird ein einfacher Text aus dem Transkript erzeugt.
ANTHROPIC_API_KEY=

# ---- Speicher ----
# Ordner für Uploads, fertige Episoden und Metadaten.
# Auf Render/Railway auf einen persistenten Datenträger legen (z. B. /data).
DATA_DIR=./data

# ---- Server ----
PORT=3000

# ---- ffmpeg (optional) ----
# Normalerweise nicht nötig: im Docker-Image ist ffmpeg installiert und liegt im PATH.
# Nur setzen, wenn ffmpeg/ffprobe an einem speziellen Pfad liegen.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
