# ---- Zugang ----
# Passwort für den Login (nur du sollst rein). Bitte ändern!
APP_PASSWORD=bitte-aendern
# Zufälliger, langer Wert zum Signieren der Login-Cookies. Bitte ändern!
SESSION_SECRET=bitte-einen-langen-zufallswert-eintragen

# ---- Öffentliche Adresse der App ----
# Vollständige URL, unter der die App erreichbar ist (ohne Slash am Ende).
# WICHTIG für den RSS-Feed: Spotify braucht absolute Links zu den MP3s.
# Beispiel: https://mein-podcast.onrender.com
PUBLIC_URL=http://localhost:3000

# ---- Transkription + Infotext (empfohlen: Gemini) ----
# Google-Gemini-Key: macht BEIDES (Audio -> Text und Text -> Beschreibung).
# Kostenloser Kontingentbereich, keine Kreditkarte nötig, gut bei Deutsch/Eigennamen.
# Hier erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modell normalerweise NICHT setzen: Die App fragt bei Google nach, welche
# Modelle der Schlüssel nutzen darf, und nimmt davon das beste. Schaltet Google
# ein Modell ab, wechselt sie von allein. Nur setzen, um eins zu erzwingen:
# GEMINI_MODEL=gemini-3-flash

# ---- Optionale Alternativen ----
# OpenAI (Whisper) – wird nur genutzt, wenn kein Gemini-Key gesetzt ist.
OPENAI_API_KEY=
# Anthropic (Claude) – alternative Quelle für den Infotext.
ANTHROPIC_API_KEY=

# ---- ElevenLabs (optional: Sprachausgabe, Stimme aufräumen, Mitschrift) ----
# Schlüssel hier erstellen: https://elevenlabs.io/app/settings/api-keys
# Gratis-Stufe: 10.000 Credits im Monat. Ohne Schlüssel bleiben alle drei
# Funktionen aus, die App läuft normal weiter.
ELEVENLABS_API_KEY=
# Stimme für die Sprachausgabe. Lässt sich auch in den Einstellungen der App
# auswählen – dann bleibt dieses Feld leer.
ELEVENLABS_VOICE_ID=
# Modelle nur setzen, um etwas anderes zu erzwingen.
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_SCRIBE_MODEL=scribe_v2
# Regionaler Server (Datenhaltung in der EU), sonst leer lassen:
# ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io/v1

# ---- Wer schreibt die Aufnahmen mit ----
# auto (Vorgabe: Gemini, sonst OpenAI, sonst ElevenLabs) | gemini | openai | elevenlabs
# ACHTUNG bei „elevenlabs": Das kostet Credits nach Audio-Dauer. Dafür holt
# ElevenLabs die Aufnahme direkt aus R2 – es läuft dann kein Byte durch die App,
# was auf Render die Bandbreite schont.
STT_ANBIETER=auto

# ---- Speicher ----
# Lokaler Ordner für Zwischenspeicher/Uploads (und Fallback ohne R2).
DATA_DIR=./data

# ---- Cloudflare R2 (empfohlen: dauerhafter, kostenloser Audio-Speicher) ----
# Alle fünf Werte setzen, dann laufen MP3s, Cover und Metadaten über R2.
# Fehlt einer, nutzt die App automatisch die lokale Platte.
# Cloudflare-Dashboard -> R2 -> Bucket anlegen, API-Token erstellen,
# und den Bucket "öffentlich" schalten (r2.dev-Subdomain oder eigene Domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Öffentliche Basis-URL des Buckets, z. B. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=

# ---- Spotify for Podcasters / Anchor (optionaler Direkt-Push) ----
# Zugangsdaten deines bestehenden Podcast-Kontos (E-Mail + Passwort, KEIN 2FA).
# Nur nötig, wenn du Folgen direkt in deine bestehende Show pushen willst.
# Achtung: inoffizieller Weg über Browser-Automation, gegen Spotify-ToS.
ANCHOR_EMAIL=
ANCHOR_PASSWORD=

# ---- Server ----
PORT=3000

# ---- ffmpeg (optional) ----
# Normalerweise nicht nötig: im Docker-Image ist ffmpeg installiert und liegt im PATH.
# Nur setzen, wenn ffmpeg/ffprobe an einem speziellen Pfad liegen.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Hinweis: Der eingebaute Cover-Generator ist entfernt. Folgen-Cover entstehen
# im Chat und werden über „Bild von einer Adresse übernehmen" eingesetzt.
# Schlüssel für Bildmodelle (Higgsfield, Gemini-Bild) braucht die App deshalb nicht.
